# Frontend Supabase Auth
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY

# Optional staff restriction
STAFF_EMAIL_DOMAIN=
STAFF_EMAIL_ALLOWLIST=

# Local development only
DISABLE_AUTH=false

# Google Sheet: share the sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer.
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
GOOGLE_SHEET_RANGE=Contacts!A:Z
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
DEFAULT_COUNTRY_CODE=91

# WhatsApp provider
WHATSAPP_PROVIDER=officialwa

# OfficialWA
OFFICIALWA_BASE_URL=https://crm.officialwa.com/api/meta/v19.0
OFFICIALWA_SENDER_ID=YOUR_OFFICIALWA_SENDER_ID
OFFICIALWA_ACCESS_TOKEN=YOUR_ROTATED_OFFICIALWA_BEARER_TOKEN
# Use local10 if your OfficialWA endpoint expects a 10-digit Indian receiver, otherwise e164.
OFFICIALWA_RECEIVER_MODE=local10

# Single-template configuration
OFFICIALWA_TEMPLATE_NAME=your_template_name
OFFICIALWA_TEMPLATE_LANGUAGE=en
OFFICIALWA_TEMPLATE_VARIABLES=0
OFFICIALWA_TEMPLATE_BODY=

# Or configure multiple templates instead:
# OFFICIALWA_TEMPLATES_JSON=[{"name":"template_one","language":"en","variables":2,"body":"Hello {{1}}, ref {{2}}","status":"APPROVED"}]

# Direct Meta Cloud API remains supported if WHATSAPP_PROVIDER=meta
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Scheduled worker authentication
CRON_SECRET=
