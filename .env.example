# Frontend Supabase Auth
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side Supabase (never expose this in VITE_ variables)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional staff restriction. Leave both blank to allow any existing Supabase user.
STAFF_EMAIL_DOMAIN=
STAFF_EMAIL_ALLOWLIST=

# Local development only. Never set true in production.
DISABLE_AUTH=false

# Google Sheet: share the sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer.
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
GOOGLE_SHEET_RANGE=Contacts!A:Z
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
DEFAULT_COUNTRY_CODE=91

# Recommended sheet headings:
# Name | Mobile Number | Category | WhatsApp Opt-In | Status
# Header aliases are detected automatically.

# WhatsApp provider: meta or custom
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_WABA_ID=YOUR_WABA_ID
WHATSAPP_ACCESS_TOKEN=YOUR_PERMANENT_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=CREATE_A_RANDOM_VERIFY_TOKEN

# Custom provider placeholders. We will map these after you share the provider's API docs.
WHATSAPP_CUSTOM_API_URL=
WHATSAPP_CUSTOM_API_TOKEN=

# Vercel cron authentication. Generate a long random secret.
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
